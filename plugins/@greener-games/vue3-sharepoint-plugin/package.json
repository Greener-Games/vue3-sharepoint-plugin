{
  "name": "@greener-games/vue3-sharepoint-plugin",
  "version": "1.1.5",
  "description": "A robust, type-safe wrapper for SharePoint operations in Vue 3 applications.",
  "author": "Greener Games",
  "license": "MIT",
  "homepage": "https://github.com/Greener-Games/vue3-sharepoint-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Greener-Games/vue3-sharepoint-plugin.git",
    "directory": "plugins/@greener-games/vue3-sharepoint-plugin"
  },
  "bugs": {
    "url": "https://github.com/Greener-Games/vue3-sharepoint-plugin/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "sharepoint",
    "pnpjs",
    "pnp",
    "mock",
    "search",
    "crud",
    "typescript",
    "plugin"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@pnp/logging": "^3.0.0",
    "@pnp/queryable": "^3.0.0",
    "@pnp/sp": "^3.0.0",
    "@vue/language-core": "^2.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.5",
    "typescript": "^5.4.4",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^3.9.1"
  }
}
