{
  "name": "@greener-games/vue3-sharepoint-plugin",
  "version": "0.0.0",
  "author": "",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:styles": "stylelint \"**/*.{css,vue}\"",
    "lint:styles:fix": "stylelint \"**/*.{css,vue}\" --fix",
    "format": "prettier --write .",
    "type-check": "vue-tsc --noEmit",
    "release": "semantic-release",
    "version": "node -e \"const fs = require('fs'); const pkg = JSON.parse(fs.readFileSync('package.json')); if (pkg.workspaces) { const { execSync } = require('child_process'); execSync('npm version ' + pkg.version + ' --workspaces --no-git-tag-version', { stdio: 'inherit' }); }\""
  },
  "dependencies": {
    "@pnp/logging": "^3.0.0",
    "@pnp/queryable": "^3.0.0",
    "@pnp/sp": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.5",
    "typescript": "^5.4.4",
    "vite": "^8.0.13",
    "vite-plugin-dts": "^4.0.0"
  }
}