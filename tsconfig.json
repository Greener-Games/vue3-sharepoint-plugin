{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "plugins/**/*",
    "plugins/**/*.vue",
    "vite.config.ts",
    "csp.config.ts"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@greener-games/vue3-sharepoint-plugin": [
        "./plugins/@greener-games/vue3-sharepoint-plugin/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "**/dist"]
}
